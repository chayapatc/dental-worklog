[Unit]
Description=Dental Worklog (gunicorn)
After=network.target

[Service]
User=chayapatc
Group=www-data
WorkingDirectory=/opt/dental-worklog
Environment="PATH=/opt/dental-worklog"
ExecStart=/usr/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
